<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-agnostic MCP-server policy shared by the two OUT-OF-PROCESS
       bridges (Acd.Mcp.Bridge, Rvt.Mcp.Bridge). Currently just the relaxed
       JSON encoder both stdio servers must use.

       Separate from Mcp.Kernel because of its ModelContextProtocol
       dependency. Acd.Mcp and Rvt.Mcp load into AutoCAD's and Revit's
       process space respectively; pulling the MCP SDK (plus its
       Microsoft.Extensions.AI closure) into those ALCs for 23 lines of
       encoder policy would be a gratuitous assembly-identity hazard in
       hosts that are already fussy about it. -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Mcp.Kernel.Bridge</AssemblyName>
    <RootNamespace>Mcp.Kernel.Bridge</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TargetFramework>net8.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Platform)' == 'x64' ">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
  </ItemGroup>

</Project>
