<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Acd.Mcp.Bridge</RootNamespace>
    <AssemblyName>Acd.Mcp.Bridge</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>


  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>


  <ItemGroup>
    <!-- Host-agnostic kernel. Mcp.Kernel carries the pipe framing + result
         envelope this bridge speaks with the in-process plugin; Mcp.Kernel.Bridge
         carries the relaxed MCP JSON encoder both bridges must use. Deliberately
         NOT Mcp.Kernel.Scripting — a bridge never compiles anything, and pulling
         Roslyn in would bloat the committed plugins/acd-mcp/bin payload. -->
    <ProjectReference Include="..\..\Shared\Mcp.Kernel\Mcp.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared\Mcp.Kernel.Bridge\Mcp.Kernel.Bridge.csproj" />
    <!-- Acd-specific wire contracts shared with the plugin via linked compile.
         Every file is AutoCAD-free records / enums; JSON is the actual boundary. -->
    <Compile Include="..\Acd.Mcp\Pipe\StatusSnapshot.cs" Link="Contracts\StatusSnapshot.cs" />
    <Compile Include="..\Acd.Mcp\Serialization\DtoDiagnosticsReport.cs" Link="Contracts\DtoDiagnosticsReport.cs" />
    <Compile Include="..\Acd.Mcp.Batch\BatchRunRecord.cs" Link="Contracts\BatchRunRecord.cs" />
    <Compile Include="..\Acd.Mcp.Batch\FileOutcomeStatus.cs" Link="Contracts\FileOutcomeStatus.cs" />
    <Compile Include="..\Acd.Mcp.Contracts\BatchMode.cs" Link="Contracts\BatchMode.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
  </ItemGroup>

</Project>
