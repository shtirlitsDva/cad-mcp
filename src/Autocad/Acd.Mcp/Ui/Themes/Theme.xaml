<!--
  Centralised dark theme for the Acd.Mcp SCRIPT + BATCH palette.

  Colours come from the host's palette (Palette.*.xaml), so it matches AutoCAD's
  or BricsCAD's own dark chrome. Every control type that has OS-themed
  parts (Button, TextBox, ListBox, ListBoxItem, ScrollBar + Thumb + RepeatButton,
  Expander + its toggle, Border) has a FULL ControlTemplate — never just a brush
  override on top of the default OS template, because that produces a "light
  popup with light text" bug for dropdowns, light scrollbar tracks, default-blue
  selection chrome, etc.

  Views must never use inline colours, fonts, or styles. They reference resources
  here via {StaticResource} (literal lookup at parse time) or {DynamicResource}
  (live lookup, used for any brush that might change for a future light-mode
  swap).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:Acd.Mcp.Ui">

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  COLOURS                                                              -->
    <!--  From the head's palette: Ui/Themes/Palette.xaml is one of            -->
    <!--  Palette.*.xaml, chosen by ThemePalette in the csproj. Nothing below  -->
    <!--  hard-codes a colour.                                                 -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  BRUSHES                                                              -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="Brush.Bg.Window"          Color="{StaticResource Color.Bg.Window}"/>
    <SolidColorBrush x:Key="Brush.Bg.Surface"         Color="{StaticResource Color.Bg.Surface}"/>
    <SolidColorBrush x:Key="Brush.Bg.Control"         Color="{StaticResource Color.Bg.Control}"/>
    <SolidColorBrush x:Key="Brush.Bg.ControlHover"    Color="{StaticResource Color.Bg.ControlHover}"/>
    <SolidColorBrush x:Key="Brush.Bg.ControlPressed"  Color="{StaticResource Color.Bg.ControlPressed}"/>
    <SolidColorBrush x:Key="Brush.Bg.RowHover"        Color="{StaticResource Color.Bg.RowHover}"/>
    <SolidColorBrush x:Key="Brush.Bg.Selected"        Color="{StaticResource Color.Bg.Selected}"/>
    <SolidColorBrush x:Key="Brush.Bg.SelectedHover"   Color="{StaticResource Color.Bg.SelectedHover}"/>

    <SolidColorBrush x:Key="Brush.Border.Subtle"      Color="{StaticResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="Brush.Border.Focused"     Color="{StaticResource Color.Border.Focused}"/>

    <SolidColorBrush x:Key="Brush.Fg.Primary"         Color="{StaticResource Color.Fg.Primary}"/>
    <SolidColorBrush x:Key="Brush.Fg.Secondary"       Color="{StaticResource Color.Fg.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Fg.Disabled"        Color="{StaticResource Color.Fg.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Fg.Failure"         Color="{StaticResource Color.Fg.Failure}"/>
    <SolidColorBrush x:Key="Brush.Fg.Success"         Color="{StaticResource Color.Fg.Success}"/>
    <SolidColorBrush x:Key="Brush.Fg.Caret"           Color="{StaticResource Color.Fg.Caret}"/>

    <SolidColorBrush x:Key="Brush.Status.Success"     Color="{StaticResource Color.Status.Success}"/>
    <SolidColorBrush x:Key="Brush.Status.Error"       Color="{StaticResource Color.Status.Error}"/>

    <SolidColorBrush x:Key="Brush.Bg.Inset"           Color="{StaticResource Color.Bg.Inset}"/>

    <SolidColorBrush x:Key="Brush.ScrollBar.Track"        Color="{StaticResource Color.ScrollBar.Track}"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb"        Color="{StaticResource Color.ScrollBar.Thumb}"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover"   Color="{StaticResource Color.ScrollBar.ThumbHover}"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbDragging" Color="{StaticResource Color.ScrollBar.ThumbDragging}"/>

    <SolidColorBrush x:Key="Brush.Accent"             Color="{StaticResource Color.Accent}"/>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  FONTS                                                                -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>
    <sys:Double x:Key="Font.Size.Body">12</sys:Double>
    <sys:Double x:Key="Font.Size.Mono">12</sys:Double>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  BASE TEXT                                                            -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Secondary}"/>
    </Style>

    <Style x:Key="Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Secondary}"/>
    </Style>

    <!-- Log row header: monospace + colour driven by IsSuccess on the bound VM. -->
    <Style x:Key="Text.LogRowHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Failure}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  BUTTON  — full template, hover / pressed / disabled / focused        -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focused}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Disabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  TEXTBOX  — full template, IsReadOnly trigger drops the chrome for    -->
    <!--             the detail-display textboxes inside the log expander.     -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg.Caret}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Bg.Selected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focused}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  SCROLLBAR  — full template, modern minimal (thumb only, no arrows).  -->
    <!--  Vertical and horizontal templates share Thumb / RepeatButton styles. -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBg"
                            Background="{DynamicResource Brush.ScrollBar.Thumb}"
                            CornerRadius="3"
                            Margin="2"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBg" Property="Background" Value="{DynamicResource Brush.ScrollBar.ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBg" Property="Background" Value="{DynamicResource Brush.ScrollBar.ThumbDragging}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <!-- Transparent invisible track surface — page-up / page-down clicks. -->
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Style="{StaticResource ScrollBar.PageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Style="{StaticResource ScrollBar.PageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Style="{StaticResource ScrollBar.PageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Style="{StaticResource ScrollBar.PageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource Brush.ScrollBar.Track}"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template" Value="{StaticResource ScrollBar.Vertical}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template" Value="{StaticResource ScrollBar.Horizontal}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollViewer: just give it our dark background. The PART_VerticalScrollBar
         and PART_HorizontalScrollBar inside default ScrollViewer template will
         resolve our implicit ScrollBar style above and inherit dark chrome. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  LISTBOX + LISTBOXITEM  — full templates                              -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.RowHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Selected}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.SelectedHover}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  EXPANDER + its header toggle  — full templates                       -->
    <!--  ExpandDirection=Down assumed; that's the only one we use. The chev-  -->
    <!--  ron is a Path with a RenderTransform that rotates on IsChecked.      -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Expander.HeaderToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderBd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Left"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="2,0,6,0">
                                <Path x:Name="Chevron"
                                      Width="6" Height="9"
                                      Stretch="Fill"
                                      Fill="{DynamicResource Brush.Fg.Secondary}"
                                      Data="M 0,0 L 6,4.5 L 0,9 Z"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource Brush.Bg.RowHover}"/>
                            <Setter TargetName="Chevron"  Property="Fill"       Value="{DynamicResource Brush.Fg.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Swap the whole RenderTransform: named children inside a
                                 Freezable's property-element block aren't reachable by
                                 TargetName, so we replace the transform value wholesale. -->
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Chevron" Property="Fill" Value="{DynamicResource Brush.Fg.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <ToggleButton DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource Expander.HeaderToggle}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalContentAlignment="Stretch"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  TOOLTIP  — full template; the OS one is a light box with dark text   -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  HELPER STYLES                                                         -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <!-- Divider line for between sections. -->
    <Style x:Key="Border.Divider" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Section panel: a Border with the surface background, used to group
         related controls (the toolbar strip, the log-header strip). -->
    <Style x:Key="Border.SectionStrip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- Detail row container inside an expanded log entry. Uses the inset
         (deepest) background so it visually nests inside the surface strips. -->
    <Style x:Key="Border.DetailBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Inset}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <!-- The BATCH palette's "N files matched" box. Green when the mask selects
         files, red when it selects none or the folder/mask is not valid, gray
         when there is no folder or a scan still runs. Hover opens the file
         list (Popup.FileList). -->
    <Style x:Key="Border.MatchBadge" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding MatchState}" Value="Matched">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Success}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding MatchState}" Value="NoMatch">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding MatchState}" Value="Error">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The hover file list. A Popup and not a ToolTip: WPF makes a tooltip
         click-through, so the wheel would go to the element below it.
         BatchControl.xaml.cs opens and closes it. -->
    <Style x:Key="Popup.FileList" TargetType="Popup">
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="StaysOpen" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style x:Key="Border.FileListPopup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style x:Key="Text.FileMatched" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Success}"/>
    </Style>

    <Style x:Key="Text.FileUnmatched" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Failure}"/>
    </Style>

    <!-- The tooltip's file lists: matched (green) above unmatched (red). -->
    <Style x:Key="ScrollViewer.FileList" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="MaxHeight" Value="400"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <DataTemplate x:Key="Template.FileMatched">
        <TextBlock Text="{Binding}" Style="{StaticResource Text.FileMatched}"/>
    </DataTemplate>

    <DataTemplate x:Key="Template.FileUnmatched">
        <TextBlock Text="{Binding}" Style="{StaticResource Text.FileUnmatched}"/>
    </DataTemplate>

    <Style x:Key="ItemsControl.FileMatched" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="ItemTemplate" Value="{StaticResource Template.FileMatched}"/>
    </Style>

    <Style x:Key="ItemsControl.FileUnmatched" TargetType="ItemsControl">
        <Setter Property="ItemTemplate" Value="{StaticResource Template.FileUnmatched}"/>
    </Style>

    <!-- A button with no chrome but a hover surface: the rows of the recent
         folders dropdown. -->
    <Style x:Key="Button.Flat" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A Button.Flat that can be clicked inside a ComboBox row (see
         ComboBoxRowButton.cs for why a plain Button cannot). -->
    <Style x:Key="Button.ComboBoxRow" TargetType="Button" BasedOn="{StaticResource Button.Flat}">
        <Setter Property="ui:ComboBoxRowButton.ClicksInsideComboBox" Value="True"/>
    </Style>

    <!-- The minus on the left of a recent folder: removes it from the list. -->
    <Style x:Key="Button.RemoveRecentFolder" TargetType="Button" BasedOn="{StaticResource Button.ComboBoxRow}">
        <Setter Property="Content" Value="−"/>
        <Setter Property="ToolTip" Value="Remove from the list"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Secondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Failure}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One row of the Folder dropdown. The buttons handle the click, so the
         ComboBox never selects a row: a pick is an explicit command. -->
    <DataTemplate x:Key="Template.RecentFolderRow">
        <DockPanel>
            <Button DockPanel.Dock="Left" Style="{StaticResource Button.RemoveRecentFolder}"
                    Command="{Binding DataContext.RemoveRecentFolderCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    CommandParameter="{Binding}"/>
            <Button Style="{StaticResource Button.ComboBoxRow}" Content="{Binding}"
                    Command="{Binding DataContext.PickRecentFolderCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    CommandParameter="{Binding}"/>
        </DockPanel>
    </DataTemplate>

    <!-- One row in the context inspector: name | type | value. Used by both
         the Globals and Variables ItemsControls in the Context expander. -->
    <DataTemplate x:Key="Template.ContextRow" DataType="{x:Type ui:ContextItem}">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Name}"
                       Style="{StaticResource Text.Mono}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding TypeName}"
                       Style="{StaticResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding Value}"
                       Style="{StaticResource Text.Mono}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </DataTemplate>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  CHECKBOX  — full template, dark theme.                                -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Inset}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="14" Height="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Width="10" Height="10"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource Brush.Fg.Primary}"
                                  StrokeThickness="2"
                                  Data="M 0,5 L 4,9 L 10,1"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focused}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  COMBOBOX  — full templates for control + drop-down ToggleButton +    -->
    <!--  ComboBoxItem. Without ALL three, WPF falls back to the Aero OS       -->
    <!--  template and you get a white popup against the dark palette.         -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <!-- Inner drop-down button: paints the ComboBox chrome (border + bg) and
         the chevron arrow. The ContentPresenter that shows the selected item
         is layered OVER this button by the ComboBox template. -->
    <Style x:Key="ComboBox.ToggleButton" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Arrow"
                                  Grid.Column="1"
                                  Width="8" Height="5"
                                  Stretch="Fill"
                                  Fill="{DynamicResource Brush.Fg.Secondary}"
                                  Data="M 0,0 L 4,4 L 8,0 Z"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd"    Property="Background" Value="{DynamicResource Brush.Bg.ControlHover}"/>
                            <Setter TargetName="Arrow" Property="Fill"       Value="{DynamicResource Brush.Fg.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd"    Property="Background" Value="{DynamicResource Brush.Bg.ControlPressed}"/>
                            <Setter TargetName="Arrow" Property="Fill"       Value="{DynamicResource Brush.Fg.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.RowHover}"/>
                        </Trigger>
                        <!-- IsHighlighted covers both keyboard-highlight and the
                             "hovered while popup is open" state — WPF sets this
                             on the active row, even before a click. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The text part of an editable ComboBox: no chrome of its own, the
         ComboBox's ToggleButton paints the box around it. -->
    <Style x:Key="ComboBox.EditableTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg.Caret}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Bg.Selected}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Control}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Right padding leaves room for the 18px arrow column so the
             selected-item text never overlaps the chevron. -->
        <Setter Property="Padding" Value="6,3,22,3"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <!-- TextElement.Foreground on the root propagates into the
                         ContentPresenter that shows the selected item, so plain
                         string items render in Fg.Primary. -->
                    <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                        <ToggleButton x:Name="PART_DropDownButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Style="{StaticResource ComboBox.ToggleButton}"/>
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"
                                          SnapsToDevicePixels="True"/>
                        <!-- Shown instead of ContentSite when IsEditable. It
                             covers all but the arrow column, so a click in the
                             text edits and a click on the arrow opens the list. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{StaticResource ComboBox.EditableTextBox}"
                                 Margin="{TemplateBinding Padding}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Visibility="Collapsed"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border x:Name="DropDownBorder"
                                    Background="{DynamicResource Brush.Bg.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_DropDownButton" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focused}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The BATCH palette's Folder box: type a path, or pick a recent one.
         Rows: Template.RecentFolderRow. -->
    <Style x:Key="ComboBox.RecentFolders" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="IsTextSearchEnabled" Value="False"/>
        <Setter Property="ItemTemplate" Value="{StaticResource Template.RecentFolderRow}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  SLIDE SWITCH (Test ◀────▶ Live)  — hand-rolled ToggleButton style.    -->
    <!--  ~ 30 lines as the spec called for. Distinct red accent when Live.    -->
    <!--  IsChecked = false → Test (slate). IsChecked = true → Live (red).     -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="Brush.SlideSwitch.Live" Color="{StaticResource Color.SlideSwitch.Live}"/>

    <Style x:Key="SlideSwitch.TestLive" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Inset}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track"
                            CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Both labels are always present; the inactive one
                                 fades to Fg.Disabled. Mono font keeps the
                                 width stable as state flips. -->
                            <TextBlock x:Name="TestLabel"
                                       Text="Test"
                                       FontFamily="{StaticResource Font.Mono}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Foreground="{DynamicResource Brush.Fg.Primary}"/>
                            <TextBlock x:Name="LiveLabel"
                                       Text="Live"
                                       FontFamily="{StaticResource Font.Mono}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"
                                       Foreground="{DynamicResource Brush.Fg.Disabled}"/>
                            <Border x:Name="Knob"
                                    Width="50" Height="20"
                                    CornerRadius="10"
                                    Background="{DynamicResource Brush.Bg.Control}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                                <TextBlock x:Name="KnobText"
                                           Text="Test"
                                           FontFamily="{StaticResource Font.Mono}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Fg.Primary}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Slide the knob to the right, swap label
                                 fades, paint the track red. No animation
                                 storyboard — keeps it simple; the user
                                 wanted hand-rolled-and-clean. -->
                            <Setter TargetName="Knob"      Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob"      Property="Margin"              Value="0,0,2,0"/>
                            <Setter TargetName="Knob"      Property="Background"          Value="{DynamicResource Brush.SlideSwitch.Live}"/>
                            <Setter TargetName="KnobText"  Property="Text"                Value="Live"/>
                            <Setter TargetName="Track"     Property="BorderBrush"         Value="{DynamicResource Brush.SlideSwitch.Live}"/>
                            <Setter TargetName="TestLabel" Property="Foreground"          Value="{DynamicResource Brush.Fg.Disabled}"/>
                            <Setter TargetName="LiveLabel" Property="Foreground"          Value="{DynamicResource Brush.Fg.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focused}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!--  SIDE TABS  — vertical SCRIPT / BATCH tabs down the left edge, like   -->
    <!--  AutoCAD's PaletteSet tabs. Used by SideTabHost (BricsCAD, whose      -->
    <!--  panels have no tabs of their own). The selected tab takes the page   -->
    <!--  colour (Bg.Window) so it reads as joined to the page.                -->
    <!-- ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="SideTab.Strip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Inset}"/>
        <Setter Property="Padding" Value="3,6,0,6"/>
    </Style>

    <Style x:Key="SideTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Secondary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3,0,0,3" Padding="5,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" CornerRadius="3,0,0,3"
                                Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.RowHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Window}"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
