<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Rvt.Mcp</RootNamespace>
    <AssemblyName>Rvt.Mcp</AssemblyName>
    <UseWPF>false</UseWPF>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Class libraries do NOT copy NuGet assets to output by default —
         without this the Roslyn DLLs never reach the deploy folder and the
         first script call dies with FileNotFoundException inside Revit. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only Revit 2025 API (CI-friendly, mirrors the AutoCAD.NET
         NuGet pattern). Revit provides the real assemblies at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- RvtGlobals (the REPL globalsType) lives here so it ends up in the
         host's default (non-collectible) ALC, not this collectible plugin's
         ALC — otherwise the Roslyn script submission can't reference it. Under
         DevReload that means "Rvt.Mcp.Api" must be in SharedAssemblies.Config.json
         below; RevitPluginManager pre-loads the side-by-side DLL into the
         default ALC before this plugin loads. Twin of Acd.Mcp -> Acd.Mcp.Api. -->
    <ProjectReference Include="..\Rvt.Mcp.Api\Rvt.Mcp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevReload reads this side-by-side config next to Rvt.Mcp.dll to decide
         which assemblies to pre-load into the default ALC. Copied to output on
         every build so a fresh clone never produces a broken bin/. -->
    <None Include="SharedAssemblies.Config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Host-agnostic kernel: the wire contract and the Roslyn plumbing.
         Both land in this project's output folder and are resolved by
         RvtMcpLoadContext's AssemblyDependencyResolver (deps.json) with a
         side-by-side fallback — same path Roslyn's own DLLs take. -->
    <ProjectReference Include="..\..\Shared\Mcp.Kernel\Mcp.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared\Mcp.Kernel.Scripting\Mcp.Kernel.Scripting.csproj" />
  </ItemGroup>

</Project>
